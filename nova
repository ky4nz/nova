local function CreateTab(tabName)
    local index = #Pages + 1
    
    local TabBtn = Instance.new("TextButton")
    TabBtn.Parent = Sidebar
    TabBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
    TabBtn.Size = UDim2.new(1, 0, 0, 30)
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = Color3.fromRGB(190, 190, 210)
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.ZIndex = 3
    
    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 4)
    TabCorner.Parent = TabBtn
    
    local Page = Instance.new("ScrollingFrame")
    Page.Parent = ContentContainer
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.ScrollBarThickness = 3
    Page.Visible = false
    Page.ZIndex = 2
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Parent = Page
    PageLayout.SortOrder = Enum.SortOrder.LayoutIndex
    PageLayout.Padding = UDim.new(0, 6)
    
    local PagePadding = Instance.new("UIPadding")
    PagePadding.Parent = Page
    PagePadding.PaddingTop = UDim.new(0, 2)
    PagePadding.PaddingRight = UDim.new(0, 5)
    
    TabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do p.Visible = false end
        Page.Visible = true
    end)
    
    if index == 1 then Page.Visible = true end
    table.insert(Pages, Page)
    return Page
end

local function AddSection(page, text)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = page
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -5, 0, 22)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = "  " .. string.upper(text)
    lbl.TextColor3 = Color3.fromRGB(150, 110, 255)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 2
end

local function AddToggle(page, text, configKey, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = page
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.Size = UDim2.new(1, -5, 0, 30)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. " : [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 2
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        _G.NovaConfig[configKey] = not _G.NovaConfig[configKey]
        local state = _G.NovaConfig[configKey]
        if state then
            btn.Text = "  " .. text .. " : [ ON ]"
            btn.TextColor3 = Color3.fromRGB(80, 255, 120)
            btn.BackgroundColor3 = Color3.fromRGB(26, 42, 32)
        else
            btn.Text = "  " .. text .. " : [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        end
        if callback then pcall(function() callback(state) end) end
    end)
end

