                        if tool:IsA("Tool") and (tool.Name:find("Melee") or tool.Name:find("Sword") or tool:FindFirstChild("Handle")) then
                            local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Validator")
                            if remote then
                                pcall(function() remote:FireServer(tool.Name) end)
                            end
                            pcall(function()
                                local localAnimations = tool:FindFirstChildOfClass("Animation")
                                if localAnimations then
                                    local animator = character:FindFirstChildOfClass("Humanoid") and character.Humanoid:FindFirstChildOfClass("Animator")
                                    if animator then
                                        animator:LoadAnimation(localAnimations):Play()
                                    end
                                end
                            end)
