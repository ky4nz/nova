local NotificationSystem = {}
function NotificationSystem:Send(title, desc, duration)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title or "Nova Hub",
            Text = desc or "",
            Duration = duration or 4
        })
    end)
end

local ErrorLogger = { Logs = {} }
function ErrorLogger:Record(module, err)
    table.insert(self.Logs, string.format("[%s] [%s]: %s", os.date("%H:%M:%S"), module, tostring(err)))
end

local UtilityModule = {}
function UtilityModule:Init()
    RunService.Stepped:Connect(function()
        if NovaConfig.AntiAFK and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                task.wait(1)
                vu:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            end)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if NovaConfig.FPSBoost then
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 9e9
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)
        end
        if NovaConfig.WhiteScreen then
            pcall(function()
                RunService:Set3dRenderingEnabled(false)
            end)
        else
            pcall(function()
                RunService:Set3dRenderingEnabled(true)
            end)
        end
    end)
end

local ESPModule = {}
local ESPObjects = {}

function ESPModule:CreateBillboard(parent, text, color)
    if parent and not parent:FindFirstChild("NovaRealESP") then
        local bg = Instance.new("BillboardGui")
        bg.Name = "NovaRealESP"
        bg.AlwaysOnTop = true
        bg.Size = UDim2.new(0, 100, 0, 40)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        
        local txt = Instance.new("TextLabel")
        txt.Parent = bg
        txt.BackgroundTransparency = 1
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.Font = Enum.Font.GothamBold
        txt.Text = text
        txt.TextColor3 = color
        txt.TextSize = 12
        txt.TextStrokeTransparency = 0.4
        
        bg.Parent = parent
        table.insert(ESPObjects, bg)
    end
end

function ESPModule:Clear()
    for _, obj in ipairs(ESPObjects) do
        if obj then obj:Destroy() end
    end
    ESPObjects = {}
end

RunService.RenderStepped:Connect(function()
    if NovaConfig.FruitESP then
        for _, v in ipairs(Workspace:GetChildren()) do
            if v:IsA("Tool") and v.Name:find("Fruit") then
                if v:FindFirstChild("Handle") then
                    ESPModule:CreateBillboard(v.Handle, "🍎 " .. v.Name, Color3.fromRGB(255, 60, 60))
                end
            end
        end
    end
    
    if NovaConfig.ChestESP then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v.Name:find("Chest") and v:IsA("Part") then
                ESPModule:CreateBillboard(v, "💰 Chest", Color3.fromRGB(255, 215, 0))
            end
        end
    end
    
    if NovaConfig.PlayerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                ESPModule:CreateBillboard(p.Character.HumanoidRootPart, p.Name, Color3.fromRGB(100, 200, 255))
            end
        end
    end
end)

