-- Dynamic Level Progression & Quest Acceptance Engine
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if _G.NovaConfig.AutoFarmLevelDynamic or _G.NovaConfig.KaitunMode then
                local dataFolder = LocalPlayer:FindFirstChild("Data")
                if dataFolder and dataFolder:FindFirstChild("Level") then
                    local currentLevel = dataFolder.Level.Value
                    local activeQuest = nil
                    
                    for _, q in ipairs(QuestData) do
                        if currentLevel >= q.MinLevel and currentLevel <= q.MaxLevel then
                            activeQuest = q
                            break
                        end
                    end
                    
                    if activeQuest then
                        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                        local mainGui = playerGui and playerGui:FindFirstChild("Main")
                        local questGui = mainGui and mainGui:FindFirstChild("Quest")
                        local isQuestVisible = questGui and questGui.Visible
                        
                        local character = LocalPlayer.Character
                        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        local humanoid = character and character:FindFirstChild("Humanoid")
                        
                        if rootPart and humanoid then
                            if not isQuestVisible then
                                local dist = (rootPart.Position - activeQuest.NPC_CF.Position).Magnitude
                                if dist > 15 then
                                    rootPart.CFrame = activeQuest.NPC_CF
                                    task.wait(0.5)
                                end
                                pcall(function()
                                    ReplicatedStorage.Remotes.CommF:InvokeServer("StartQuest", activeQuest.QuestName, 1)
                                end)
                            else
                                humanoid.PlatformStand = false
                                for _, part in ipairs(character:GetChildren()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end
                                
                                -- Safe Bring Mob (Monster Magnet) Mechanic
                                local enemiesFolder = Workspace:FindFirstChild("Enemies")
                                if enemiesFolder then
                                    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                                        local eRoot = enemy:FindFirstChild("HumanoidRootPart")
                                        local eHum = enemy:FindFirstChild("Humanoid")
                                        if eRoot and eHum and eHum.Health > 0 then
                                            if enemy.Name == activeQuest.MonsterName and (eRoot.Position - rootPart.Position).Magnitude <= 350 then
                                                eRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
                                                eHum.PlatformStand = true
                                            end
                                        end
                                    end
                                end
                                
                                local targetPos = activeQuest.Monster_CF + Vector3.new(0, 10, 0)
                                rootPart.CFrame = CFrame.new(targetPos)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- Safe Mobile Fast Attack Engine (No VirtualInputManager crash)
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if _G.NovaConfig.M1SpamActive or _G.NovaConfig.AttackMode == "Fast Attack" or _G.NovaConfig.AttackMode == "QUANTUM" then
                local character = LocalPlayer.Character
                if character then
